# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# JWT Secrets (use long random strings in production)
JWT_SECRET="your-jwt-secret-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars"

# Redis (Upstash — use rediss:// for TLS)
REDIS_URL="rediss://default:password@host:6380"

# Server
PORT=4000
NODE_ENV=development

# CORS (comma-separated for multiple origins)
# production: CORS_ORIGIN="https://selfless-admin.vercel.app"
CORS_ORIGIN="http://localhost:3000"

# Email (Gmail App Password)
# Enable 2FA on your Google account then create an App Password at:
# https://myaccount.google.com/apppasswords
GMAIL_USER="your@gmail.com"
GMAIL_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# Telegram Bot (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN="1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TELEGRAM_BOT_USERNAME="YourBotUsername"
