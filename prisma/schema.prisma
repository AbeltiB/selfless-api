generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum OrgStatus {
  ACTIVE
  SUSPENDED
  OFFBOARDING
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  BRANCH_MANAGER
  SUPERVISOR
  OFFICER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  PIN_RESET
  DEVICE_TRUST
}

enum TicketStatus {
  CREATED
  WAITING
  CALLED
  IN_SERVICE
  TRANSFERRED
  ON_HOLD
  AWAITING_PAYMENT
  AWAITING_DOCUMENT
  COMPLETED
  REJECTED
  CANCELLED
  NO_SHOW
  EXPIRED
  ABANDONED
}

enum QueueStatus {
  OPEN
  CLOSED
  PAUSED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum StepType {
  SERVICE
  PAYMENT
  DOCUMENT_REVIEW
  APPROVAL
  VERIFICATION
  CUSTOM
}

enum RequirementType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT
  IMAGE
  DOCUMENT
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT
  PHONE
  EMAIL
}

enum ServiceType {
  WALK_IN
  APPOINTMENT
  BOTH
}

enum TicketEventType {
  CREATED
  CALLED
  SERVING_STARTED
  TRANSFERRED
  ON_HOLD
  RESUMED
  AWAITING_PAYMENT
  AWAITING_DOCUMENT
  COMPLETED
  REJECTED
  CANCELLED
  NO_SHOW
  EXPIRED
  NOTE_ADDED
  COUNTER_ASSIGNED
  STEP_ADVANCED
}

enum NotificationChannel {
  SMS
  EMAIL
  TELEGRAM
  PUSH
}

// ─── Organization (Tenant Root) ───────────────────────────────────────────────

model Organization {
  id        String    @id @default(uuid())
  name      String
  code      String    @unique
  logo      String?
  status    OrgStatus @default(ACTIVE)
  settings  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  branches           Branch[]
  memberships        OrgMembership[]
  workflows          Workflow[]
  counterGroups      CounterGroup[]
  tickets            Ticket[]
  appointments       Appointment[]
  analyticsSnapshots AnalyticsSnapshot[]
  priorityFlags      PriorityFlag[]
  notifications      Notification[]
}

// ─── Branch ───────────────────────────────────────────────────────────────────

model Branch {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String
  address        String?
  latitude       Float?
  longitude      Float?
  timezone       String       @default("UTC")
  operatingHours Json?
  maxCapacity    Int          @default(100)
  status         BranchStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  services           Service[]
  counters           Counter[]
  memberships        OrgMembership[]      @relation("MembershipBranch")
  queues             Queue[]
  tickets            Ticket[]
  appointments       Appointment[]
  analyticsSnapshots AnalyticsSnapshot[]

  @@unique([organizationId, code])
}

// ─── Workflow ─────────────────────────────────────────────────────────────────

model Workflow {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  steps    WorkflowStep[]
  services Service[]
}

model WorkflowStep {
  id             String        @id @default(uuid())
  workflowId     String
  workflow       Workflow      @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  name           String
  stepType       StepType      @default(SERVICE)
  order          Int
  slaMinutes     Int?
  counterGroupId String?
  counterGroup   CounterGroup? @relation(fields: [counterGroupId], references: [id])
  isInitial      Boolean       @default(false)
  isFinal        Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  transitionsFrom WorkflowTransition[] @relation("TransitionSource")
  transitionsTo   WorkflowTransition[] @relation("TransitionDest")
  queues          Queue[]
  currentTickets  Ticket[]             @relation("CurrentStep")
}

model WorkflowTransition {
  id                String       @id @default(uuid())
  workflowId        String
  sourceStepId      String
  sourceStep        WorkflowStep @relation("TransitionSource", fields: [sourceStepId], references: [id], onDelete: Cascade)
  destinationStepId String
  destinationStep   WorkflowStep @relation("TransitionDest", fields: [destinationStepId], references: [id])
  condition         Json?
  label             String?
  order             Int          @default(0)
  createdAt         DateTime     @default(now())
}

// ─── Counter ──────────────────────────────────────────────────────────────────

model CounterGroup {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  counters      Counter[]
  workflowSteps WorkflowStep[]
}

model Counter {
  id        String        @id @default(uuid())
  branchId  String
  branch    Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  groupId   String?
  group     CounterGroup? @relation(fields: [groupId], references: [id])
  name      String
  code      String
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  currentTickets Ticket[] @relation("CurrentCounter")

  @@unique([branchId, code])
}

// ─── Service ──────────────────────────────────────────────────────────────────

model Service {
  id                String      @id @default(uuid())
  branchId          String
  branch            Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  workflowId        String?
  workflow          Workflow?   @relation(fields: [workflowId], references: [id])
  name              String
  code              String
  description       String?
  estimatedDuration Int         @default(10)
  prefix            String      @default("A")
  serviceType       ServiceType @default(WALK_IN)
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  requirements       Requirement[]
  forms              Form[]
  queues             Queue[]
  tickets            Ticket[]
  appointments       Appointment[]
  analyticsSnapshots AnalyticsSnapshot[]

  @@unique([branchId, code])
}

// ─── Requirements ─────────────────────────────────────────────────────────────

model Requirement {
  id              String          @id @default(uuid())
  serviceId       String
  service         Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name            String
  type            RequirementType
  required        Boolean         @default(true)
  validationRules Json?
  order           Int             @default(0)
  createdAt       DateTime        @default(now())
}

// ─── Dynamic Forms ────────────────────────────────────────────────────────────

model Form {
  id        String      @id @default(uuid())
  serviceId String
  service   Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  fields FormField[]
}

model FormField {
  id         String    @id @default(uuid())
  formId     String
  form       Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  label      String
  fieldKey   String
  fieldType  FieldType
  required   Boolean   @default(false)
  options    Json?
  conditions Json?
  order      Int       @default(0)
  createdAt  DateTime  @default(now())
}

// ─── Account (unified identity — phone + OTP + PIN) ──────────────────────────

model Account {
  id                String        @id @default(uuid())

  phone             String        @unique
  pinHash           String?
  pinFailedAttempts Int           @default(0)
  pinLockedUntil    DateTime?

  firstName         String
  lastName          String?
  email             String?
  telegramId        String?       @unique
  telegramUsername  String?
  photoUrl          String?

  addressLine1      String?
  addressLine2      String?
  city              String?
  region            String?
  country           String?
  dateOfBirth       DateTime?

  status            AccountStatus @default(ACTIVE)
  lastLoginAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  memberships       OrgMembership[]
  trustedDevices    TrustedDevice[]
  priorityFlags     AccountPriorityFlag[]
  tickets           Ticket[]      @relation("TicketCustomer")
  operatedTickets   Ticket[]      @relation("TicketOperator")
  ticketEvents      TicketEvent[]
  appointments      Appointment[]
}

// ─── OrgMembership (per-organization role for an Account) ────────────────────

model OrgMembership {
  id             String       @id @default(uuid())
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?      @relation("MembershipBranch", fields: [branchId], references: [id])
  role           UserRole     @default(OFFICER)
  isActive       Boolean      @default(true)
  invitedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([accountId, organizationId])
  @@index([organizationId, branchId])
}

// ─── OTP verification ─────────────────────────────────────────────────────────

model OtpVerification {
  id          String     @id @default(uuid())
  phone       String
  purpose     OtpPurpose
  codeHash    String
  expiresAt   DateTime
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  consumedAt  DateTime?
  requestIp   String?
  createdAt   DateTime   @default(now())

  @@index([phone, purpose, consumedAt])
}

// ─── Trusted devices (OTP skip on known devices) ─────────────────────────────

model TrustedDevice {
  id              String    @id @default(uuid())
  accountId       String
  account         Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deviceTokenHash String    @unique
  label           String?
  userAgent       String?
  ip              String?
  lastUsedAt      DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([accountId])
}

// ─── Priority / fairness flags ────────────────────────────────────────────────

model PriorityFlag {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  weight         Int      @default(10)
  color          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  accountFlags AccountPriorityFlag[]
  ticketFlags  TicketPriorityFlag[]

  @@unique([organizationId, name])
}

model AccountPriorityFlag {
  id         String       @id @default(uuid())
  accountId  String
  account    Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  flagId     String
  flag       PriorityFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)
  assignedBy String?
  assignedAt DateTime     @default(now())
  expiresAt  DateTime?
  notes      String?

  @@unique([accountId, flagId])
}

model TicketPriorityFlag {
  id         String       @id @default(uuid())
  ticketId   String
  ticket     Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  flagId     String
  flag       PriorityFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)
  assignedBy String?
  assignedAt DateTime     @default(now())
  notes      String?

  @@unique([ticketId, flagId])
}

// ─── Queue ────────────────────────────────────────────────────────────────────

model Queue {
  id            String        @id @default(uuid())
  branchId      String
  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  serviceId     String
  service       Service       @relation(fields: [serviceId], references: [id])
  stepId        String?
  step          WorkflowStep? @relation(fields: [stepId], references: [id])
  date          DateTime      @default(now())
  status        QueueStatus   @default(OPEN)
  currentNumber Int           @default(0)
  prefix        String        @default("A")
  openedAt      DateTime      @default(now())
  closedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// ─── Ticket ───────────────────────────────────────────────────────────────────

model Ticket {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id])
  serviceId      String
  service        Service      @relation(fields: [serviceId], references: [id])
  customerId     String?
  customer       Account?     @relation("TicketCustomer", fields: [customerId], references: [id])

  queueNumber String
  prefix      String @default("A")

  workflowId       String?
  currentStepId    String?
  currentStep      WorkflowStep? @relation("CurrentStep", fields: [currentStepId], references: [id])
  currentCounterId String?
  currentCounter   Counter?      @relation("CurrentCounter", fields: [currentCounterId], references: [id])
  operatorId       String?
  operator         Account?      @relation("TicketOperator", fields: [operatorId], references: [id])

  status        TicketStatus @default(CREATED)
  priority      Int          @default(0)
  notes         String?
  formData      Json?

  issuedAt      DateTime  @default(now())
  calledAt      DateTime?
  servedAt      DateTime?
  completedAt   DateTime?
  waitSeconds   Int?
  serviceSeconds Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events        TicketEvent[]
  priorityFlags TicketPriorityFlag[]

  @@index([branchId, status])
  @@index([organizationId, createdAt])
  @@index([customerId])
}

// ─── Ticket Event (Audit Trail) ───────────────────────────────────────────────

model TicketEvent {
  id        String          @id @default(uuid())
  ticketId  String
  ticket    Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  eventType TicketEventType
  actorId   String?
  actor     Account?        @relation(fields: [actorId], references: [id])

  fromStatus TicketStatus?
  toStatus   TicketStatus?
  fromStepId String?
  toStepId   String?
  counterId  String?
  metadata   Json?
  createdAt  DateTime @default(now())
}

// ─── Appointment ──────────────────────────────────────────────────────────────

model Appointment {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  branchId       String
  branch         Branch            @relation(fields: [branchId], references: [id])
  serviceId      String
  service        Service           @relation(fields: [serviceId], references: [id])
  customerId     String?
  customer       Account?          @relation(fields: [customerId], references: [id])

  scheduledAt DateTime
  duration    Int               @default(30)
  status      AppointmentStatus @default(PENDING)
  notes       String?
  ticketId    String?

  reminderSentAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([branchId, scheduledAt])
  @@index([customerId])
}

// ─── Notification ─────────────────────────────────────────────────────────────

model Notification {
  id             String              @id @default(uuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel        NotificationChannel
  recipientId    String?
  subject        String?
  body           String
  status         String              @default("PENDING")
  metadata       Json?
  sentAt         DateTime?
  error          String?
  createdAt      DateTime            @default(now())

  @@index([organizationId, createdAt])
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  timestamp  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}

// ─── Analytics ────────────────────────────────────────────────────────────────

model AnalyticsSnapshot {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  branchId        String
  branch          Branch       @relation(fields: [branchId], references: [id])
  serviceId       String
  service         Service      @relation(fields: [serviceId], references: [id])
  date            DateTime
  hour            Int
  avgWaitSeconds  Int          @default(0)
  ticketsServed   Int          @default(0)
  ticketsNoShow   Int          @default(0)
  ticketsRejected Int          @default(0)
  p95WaitSeconds  Int          @default(0)
  createdAt       DateTime     @default(now())

  @@unique([branchId, serviceId, date, hour])
}
